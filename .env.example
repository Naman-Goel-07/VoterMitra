# Copy to .env.local. Set only the services you need.
PUBLIC_BASE_URL=http://localhost:3000

# Optional PostgreSQL connection. Use verified TLS for remote databases.
DATABASE_URL=

# Optional provider integrations
GNANI_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# Optional demo reviewer account. Use different random values for the passcode
# and session secret. The role is set here, outside the sign-in form.
DASHBOARD_REVIEWER_NAME=
DASHBOARD_REVIEWER_ROLE="Field Auditor"
DASHBOARD_PASSCODE=
SESSION_SECRET=

# Optional expected number of planted scenarios in a private benchmark
BENCHMARK_PLANTED_TOTAL=
